name = "beacon"
main = "src/index.ts"
compatibility_date = "2026-07-09"
account_id = "your-cloudflare-account-id"  # find via: npx wrangler whoami

# Custom domain route for production. Remove this block to use the default
# *.workers.dev subdomain instead.
[[routes]]
pattern = "your-api-domain.example.com"
custom_domain = true

[vars]
ALLOWED_ORIGIN = "https://your-dashboard-domain.example.com"
PAGES_PREVIEW_SUFFIX = ".your-pages-project.pages.dev"
# This worker's own public origin — must match the [[routes]] pattern above
# (with a scheme). Used to build absolute agent/client WebSocket URLs for
# remote sessions; kept as an explicit var rather than derived from the
# incoming request so it can't be misdirected by routing/proxy config.
WORKER_URL = "https://your-api-domain.example.com"

# Backblaze B2 (S3-compatible) object storage. R2 bucket bindings are NOT
# required; configure B2 vars below and set secrets via `wrangler secret put`.
# Keep bucket names/endpoint/region non-secret in vars; application keys are secrets.
# Single-bucket layout: one private bucket, key prefixes branding/, components/,
# rustdesk-installer/, sessions/ (see worker/src/index.ts resolvers).
B2_ENDPOINT = "https://s3.eu-central-003.backblazeb2.com"
B2_REGION = "eu-central-003"
B2_BUCKET = "rommm13-beacon-storage"
B2_BUCKET_LOGOS = "rommm13-beacon-storage"
B2_BUCKET_COMPONENT_FILES = "rommm13-beacon-storage"
B2_BUCKET_SESSION_FILES = "rommm13-beacon-storage"
B2_PRESIGN_EXPIRES_SECONDS = "900"

# Optional hosted-scheduler secret. Keep it as a Worker secret, never a var:
# # npx wrangler secret put INTERNAL_SCHEDULER_SECRET
#
# B2 secrets (set only via wrangler secret put; never commit values):
# # npx wrangler secret put B2_APPLICATION_KEY_ID
# # npx wrangler secret put B2_APPLICATION_KEY

[[d1_databases]]
binding = "DB"
database_name = "beacon"
database_id = "your-d1-database-id"
migrations_dir = "../migrations"

[triggers]
crons = ["*/2 * * * *"]

[[durable_objects.bindings]]
name = "SESSION"
class_name = "SessionRelay"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["SessionRelay"]

# Required encrypted Worker secrets. For the first deployment, provide both
# atomically with `wrangler deploy --secrets-file`; see docs/SELF_HOSTING.md.
# Do not add a `[secrets] required = [...]` block without also changing the
# local-development setup: Wrangler then excludes extra `.dev.vars` keys such
# as the required local WORKER_URL override.
#
# Secret meanings (values never belong in this file):
#   ADMIN_SECRET          — break-glass bootstrap/recovery bearer token
#   CONFIG_ENCRYPTION_KEY — 32 random bytes hex (e.g. `openssl rand -hex 32`),
#                           encrypts SSO provider client secrets at rest
#   B2_APPLICATION_KEY_ID — Backblaze B2 application key ID (wrangler secret put)
#   B2_APPLICATION_KEY    — Backblaze B2 application key (wrangler secret put)
#   CHATGPT_ADAPTER_KEY   — Bearer key for /v1/chatgpt/* adapter (wrangler secret put)
